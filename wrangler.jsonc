{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coruja",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The Svelte app is a SPA; /api/* always reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coruja",
      // Local dev works with any value. Replace with the real id from `wrangler d1 create coruja` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // TEAM_PASSWORD is a secret: `.dev.vars` locally, `wrangler secret put TEAM_PASSWORD` in production.
  "observability": {
    "enabled": true
  }
}
