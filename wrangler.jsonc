{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coruja",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The Svelte app is a SPA; /api/* always reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Needs the verme.net zone on this Cloudflare account; deploy creates the DNS record and certificate.
  "routes": [{ "pattern": "coruja.verme.net", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coruja",
      // Production database (local dev uses its own copy under .wrangler/, whatever the id).
      "database_id": "ff12930d-caca-4251-88e9-dbe021551d0f",
      "migrations_dir": "migrations"
    }
  ],
  // Daily at 03:00 UTC = midnight in São Paulo (no DST since 2019): opens the next month on the 20th.
  // Runs /api/* next to the D1 primary (ENAM, Northern Virginia): one long hop per request instead of
  // one per query. Static assets are still served from the edge (decisions #29).
  "placement": { "region": "aws:us-east-1" },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // TEAM_PASSWORD is a secret: `.dev.vars` locally, `wrangler secret put TEAM_PASSWORD` in production.
  "observability": {
    "enabled": true
  }
}
