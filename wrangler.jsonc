{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coruja",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // The Svelte app is a SPA; /api/* always reaches the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Needs the verme.net zone on this Cloudflare account; deploy creates the DNS record and certificate.
  "routes": [{ "pattern": "coruja.verme.net", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coruja",
      // Production database (local dev uses its own copy under .wrangler/, whatever the id).
      "database_id": "ff12930d-caca-4251-88e9-dbe021551d0f",
      "migrations_dir": "migrations"
    }
  ],
  // Runs /api/* next to the D1 primary (ENAM, Northern Virginia): one long hop per request instead of
  // one per query. Static assets are still served from the edge (decisions #29).
  "placement": { "region": "aws:us-east-1" },
  "vars": { "APP_URL": "https://coruja.verme.net" },
  // Shift reminders: every minute, the Worker sends whatever reminder is due (decisions #32).
  "triggers": { "crons": ["* * * * *"] },
  // PR previews (decisions #33): every branch but master gets <branch>-coruja.<subdomain>.workers.dev
  // through Workers Builds' `wrangler preview`. Previews inherit nothing from production: they get the
  // staging database below, their own TEAM_PASSWORD (Preview base config) and no NTFY_* secrets, so
  // they never notify anyone. Cron triggers do not run on previews.
  "preview_urls": true,
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "coruja-staging",
        "database_id": "755bc250-6a69-4bd6-8033-cb4fa7b52d86",
        "migrations_dir": "migrations"
      }
    ],
    "vars": { "APP_URL": "" },
    "placement": { "region": "aws:us-east-1" },
    "observability": { "enabled": true }
  },
  // Secrets: `.dev.vars` locally, `wrangler secret put <NAME>` in production. TEAM_PASSWORD, and
  // NTFY_URL + NTFY_TOKEN for notifications (both optional: unset = no notifications).
  "observability": {
    "enabled": true
  }
}
