{
  "name": "coruja",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "svelte-check --tsconfig ./tsconfig.web.json --fail-on-warnings && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run check && bun run test",
    "db:migrate:local": "wrangler d1 migrations apply coruja --local",
    "db:migrate:remote": "wrangler d1 migrations apply coruja --remote",
    "db:generate": "drizzle-kit generate",
    "suggest": "bun scripts/suggest-roster.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.72.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "fflate": "^0.8.3",
    "miniflare": "^4.20260730.0",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "1.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
